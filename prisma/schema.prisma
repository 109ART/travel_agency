generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  STAFF
}

enum QuoteStatus {
  PENDING
  QUOTATION_SENT
  CONFIRMED
  CANCELLED
}

enum FlightStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  HALF
  PAID
}

model Admin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
}

// Single User model, linked to all three request types
model User {
  id         String   @id @default(cuid())
  name       String
  phone      String
  email      String?  @unique
  cnic       String?
  passportNo String?
  createdAt  DateTime @default(now())

  flightBookings FlightBooking[]
  umrahRequests  UmrahRequest[]
  visaRequests   VisaRequest[]

  @@index([phone])
}

model UmrahRequest {
  id            String        @id @default(cuid())
  reference     String        @unique
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  travelers     Int           @default(1)
  preferredDate DateTime?
  nightsMakkah  Int
  nightsMadinah Int
  hotelCategory String
  needsVisa     Boolean       @default(true)
  notes         String?
  cnic          String
  passportNo    String
  quotedPrice   Int? // PKR
  quotedAt      DateTime?
  status        QuoteStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
}

model VisaRequest {
  id             String        @id @default(cuid())
  reference      String        @unique
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  country        String
  visaType       String
  entryType      String
  travelers      Int           @default(1)
  travelDate     DateTime?
  passportExpiry DateTime?
  cnic           String
  passportNo     String
  notes          String?
  quotedPrice    Int? // PKR
  quotedAt       DateTime?
  status         QuoteStatus   @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
}

model FlightBooking {
  id            String        @id @default(cuid())
  reference     String        @unique
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  tripType      String // One way / Return
  fromCity      String
  toCity        String
  departureDate DateTime
  returnDate    DateTime?
  passengers    Int           @default(1)
  cabinClass    String
  cnic          String
  passportNo    String
  notes         String?
  fare          Int? // PKR
  status        FlightStatus  @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  adminName String
  action    String
  target    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
